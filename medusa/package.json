{
  "name": "interfacer-medusa-spike",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:migrate": "medusa db:migrate",
    "start": "medusa develop --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "project": "medusa exec ./src/scripts/project.ts",
    "verify": "medusa exec ./src/scripts/verify.ts",
    "inspect": "medusa exec ./src/scripts/inspect.ts"
  },
  "dependencies": {
    "@medusajs/cli": "2.10.3",
    "@medusajs/framework": "2.10.3",
    "@medusajs/medusa": "2.10.3",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "typescript": "5.6.3",
    "ts-node": "10.9.2"
  }
}
