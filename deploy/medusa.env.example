# Interfacer marketplace pilot (docs/deploy-pilot.md). Keep the real file 0600.
NODE_ENV=production
INTERFACER_DEPLOYMENT=pilot
DATABASE_URL=postgres://medusa:<db password>@db:5432/medusa
# DATABASE_SSL=true only for a Postgres that speaks TLS (the compose one does not).
# This instance's name inside every signed envelope.
INTERFACER_COMMERCE_AUDIENCE=interfacer-commerce:<instance>
# Shared with the GUI (MEDUSA_PROXY_KEY): openssl rand -hex 32
INTERFACER_PROXY_KEY=
JWT_SECRET=
COOKIE_SECRET=
# Zenflows, and the marketplace's own service Person on it (zenflows-actor.cjs create).
INTERFACER_ZENFLOWS_URL=https://<zenflows host>/api
INTERFACER_ZENFLOWS_SIGNED_WRITES=true
INTERFACER_ZENFLOWS_SERVICE_USER=
INTERFACER_ZENFLOWS_SERVICE_SEED=
MEDUSA_DISABLE_TELEMETRY=true
