+ assert.ok(page);
+ for(const lang of ['en','it']){
+  const text=page.sections.map(s=>s.body[lang]).join(' ');
+  for(const term of ['outputOf','50','28','9/9','interfacer-gui-h0n','interfacer-gui-nhn','interfacer-gui-dz7'])assert.ok(text.includes(term),lang+': '+term);
+  assert.ok(page.sources.every(s=>/\/blob\/[0-9a-f]{40}\//.test(s.url)));
+ }
+});
